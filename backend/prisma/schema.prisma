generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                @id @default(uuid())
  username             String                @unique
  name                 String
  initials             String
  color                String
  password             String
  role                 String                @default("USER") // 'ADMIN' | 'VENTAS' | 'DISENO' | 'TALLER' | 'USER'
  status               String                @default("offline") // 'available' | 'busy' | 'offline'
  /// Preferencias de UI (tema, etc.) — merge parcial vía PATCH /api/users/me
  preferences          Json?
  /// Ruta pública del avatar, p. ej. /uploads/1234-abc.jpg (subida vía PATCH /api/users/:id/avatar)
  avatarUrl            String?
  createdAt            DateTime              @default(now())
  notifications        Notification[]
  feedPosts            FeedPost[]
  pushSubscriptions    PushSubscription[]
  updates              Update[]
  cotizaciones         Cotizacion[]
  userTasks            UserTask[]
  assignedUserTasks    UserTask[]            @relation("UserTaskAssignee")
  taskAssignments      UserTaskAssignment[]
  userTaskLists        UserTaskList[]
  workshopProjects     Workshop3DProject[]   @relation("Workshop3DProjectCreator")
  workshopQuotations   Workshop3DQuotation[] @relation("Workshop3DQuotationCreator")
}

/// Lista de tareas (varias por usuario, estilo Google Tasks).
model UserTaskList {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String    @default("Mis tareas")
  position  Float     @default(0)
  tasks     UserTask[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, position])
}

/// Tarea o subtarea dentro de una lista (parentId null = raíz).
model UserTask {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assigneeUserId String?
  assignee      User? @relation("UserTaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  assignments UserTaskAssignment[]
  listId    String
  list      UserTaskList @relation(fields: [listId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    UserTask? @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  children  UserTask[] @relation("TaskSubtasks")
  title     String
  notes     String    @default("")
  completed Boolean   @default(false)
  position  Float     @default(0)
  dueDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, listId, parentId, position])
  @@index([userId, completed])
  @@index([assigneeUserId, completed])
}

model UserTaskAssignment {
  taskId     String
  userId     String
  task       UserTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([taskId, userId])
  @@index([userId])
}

/// Cotización guardada (folio autoincremental; PDF en cliente; pdfUrl reservado para subida futura).
model Cotizacion {
  id          String           @id @default(cuid())
  folio       Int              @unique @default(autoincrement())
  creadoPorId String
  creadoPor   User             @relation(fields: [creadoPorId], references: [id], onDelete: Restrict)
  cliente     String?
  total       Float
  creadoEn    DateTime         @default(now())
  pdfUrl      String?
  items       CotizacionItem[]
}

model CotizacionItem {
  id           String     @id @default(cuid())
  cotizacionId String
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  servicio     String
  cantidad     Float
  sufijo       String
  precioUnit   Float
  total        Float
}

model Workspace {
  id               String   @id @default(uuid())
  name             String
  description      String?
  panelNotes       String? // JSON array (legacy string): [{ id, x, y, title, body }] para vista general de Docs
  panelNotesJson   Json?   // Sombra JSONB para Postgres
  docGroups        String? // JSON por usuario (legacy string): { "userId": { groups: [{ id, name }], assignments: { docId: groupId } } }
  docGroupsJson    Json?   // Sombra JSONB para Postgres
  boards           Board[]
  docs             Doc[]
  designs          Design[]
  workshopProjects Workshop3DProject[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Board {
  id             String          @id @default(uuid())
  name           String
  workspaceId    String
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  groups         Group[]
  columns        BoardColumn[]
  docs           Doc[]
  calendarEvents CalendarEvent[]
  designs        Design[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model CalendarEvent {
  id        String   @id @default(uuid())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  eventDate DateTime
  name      String
  eventType String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Group {
  id            String   @id @default(uuid())
  name          String
  color         String   @default("#1d60f5")
  position      Float
  boardId       String
  board         Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  parentGroupId String?
  parent        Group?   @relation("GroupToSubgroups", fields: [parentGroupId], references: [id], onDelete: Cascade)
  children      Group[]  @relation("GroupToSubgroups")
  items         Item[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Item {
  id           String         @id @default(uuid())
  name         String
  position     Float
  groupId      String
  group        Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  columnValues ColumnValue[]
  updates      Update[]
  notifications Notification[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model BoardColumn {
  id       String        @id @default(uuid())
  title    String
  type     String // 'status', 'date', 'person', 'priority', 'text', 'timeline', 'number'
  position Float
  boardId  String
  board    Board         @relation(fields: [boardId], references: [id], onDelete: Cascade)
  settings     String? // JSON string (legacy) for specific settings
  settingsJson Json?   // Sombra JSONB para Postgres
  values   ColumnValue[]

  @@unique([boardId, title, type])
}

// TODO(db/indexes): agregar índices de consulta frecuentes en próximo deploy con migración dedicada:
// - Board: @@index([workspaceId])
// - Group: @@index([boardId])
// - Item: @@index([groupId])
// - BoardColumn: @@index([boardId]) (además del unique compuesto)
// - Doc: @@index([workspaceId]) y @@index([boardId])
// - CalendarEvent: @@index([boardId, eventDate])

model ColumnValue {
  id       String      @id @default(uuid())
  value    String // JSON string (legacy) o texto plano
  valueJson Json? // Sombra JSONB para Postgres
  itemId   String
  item     Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  columnId String
  column   BoardColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  /// FIX 11: control de concurrencia (optimistic locking) en updates vía socket
  updatedAt DateTime   @default(now()) @updatedAt

  @@unique([itemId, columnId])
}

model Update {
  id        String   @id @default(uuid())
  content   String
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type      String   // e.g. 'assigned', 'item_created'
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt(sort: Desc)])
  @@index([itemId, createdAt])
}

// Feed de la Bandeja: publicaciones con @mentions (no ligadas a un item)
model FeedPost {
  id              String   @id @default(uuid())
  content         String
  authorId        String
  author          User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  mentionedUserIds     String   @default("[]") // JSON array of user IDs (legacy)
  mentionedUserIdsJson Json?    // Sombra JSONB para Postgres
  createdAt            DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
}

model Doc {
  id          String   @id @default(uuid())
  title       String
  type        String   @default("text") // 'text' | 'sheet'
  content     String   @default("{}")   // JSON string legacy
  contentJson Json?                 // Sombra JSONB para Postgres
  boardId     String?
  board       Board?   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Design {
  id          String   @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  content     String   @default("{}")   // JSON string (Fabric canvas o estructura mixta)
  contentJson Json?                     // Sombra JSONB para Postgres (json + svg)
  thumbnailUrl String?
  boardId     String?
  board       Board?   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Configuración global de plantillas PDF (posiciones, fuente). Solo editable por ADMIN.
model TemplateConfig {
  id              String   @id @default(uuid())
  docType         String   @unique // 'cotizacion' | 'levantamiento' | 'hoja_trabajo'
  fieldPositions     String @default("{}") // JSON legacy: Record<fieldKey, { x, y }>
  fieldPositionsJson Json?                 // Sombra JSONB para Postgres
  fontColor       String   @default("#000000")
  fontFamily      String   @default("Helvetica")
  fontSize        Int      @default(11)   // pt
  fontBold        Boolean  @default(false)
  fontItalic      Boolean  @default(false)
  customBoxes     String   @default("[]") // JSON legacy: [{ id, x, y, width, height, singleLine? }]
  customBoxesJson Json?                   // Sombra JSONB para Postgres
  /// Texto/contenido por defecto para documentos nuevos (lo que el admin edita en el master).
  defaultContentJson Json?
  updatedAt       DateTime @updatedAt
}

/// Suscripciones Web Push por usuario (para PWA / notificaciones push)
model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String
  p256dh    String
  auth      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([endpoint, userId])
}


// ─── Sunday 3D Workshop ──────────────────────────────────────────

/// Proyecto 3D Workshop: contiene la escena completa, parámetros y metadatos.
model Workshop3DProject {
  id          String   @id @default(uuid())
  name        String
  description String?
  /// Datos completos de la escena 3D (objetos, transformaciones, materiales, parámetros)
  sceneData   Json     @default("{}")
  /// Configuración del catálogo de materiales personalizado del proyecto
  catalogData Json?
  /// Miniatura del proyecto (data URL o ruta)
  thumbnailUrl String?
  createdById String
  createdBy   User     @relation("Workshop3DProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  quotations  Workshop3DQuotation[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
  @@index([createdById])
}

/// Cotización generada a partir de un proyecto 3D Workshop (snapshot de costos).
model Workshop3DQuotation {
  id          String   @id @default(uuid())
  folio       Int      @unique @default(autoincrement())
  projectId   String
  project     Workshop3DProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Nombre del cliente
  cliente     String?
  /// Moneda (ISO 4217), default MXN
  currency    String   @default("MXN")
  /// Snapshot completo de la cotización: lineItems, subtotales, totales, márgenes
  breakdownData Json
  /// Total final (precio de venta)
  totalPrice  Float
  /// Costo directo total
  totalCost   Float
  /// Margen bruto (%)
  grossMargin Float?
  /// Notas adicionales
  notes       String?
  createdById String
  createdBy   User     @relation("Workshop3DQuotationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@index([projectId])
  @@index([createdById])
}

/// Catálogo global de materiales y componentes para 3D Workshop (editable por ADMIN).
model Workshop3DCatalogEntry {
  id          String   @id @default(uuid())
  /// Categoría: filamento, acrilico, pvc, led, fuente, hardware, adhesivo, otro
  category    String
  name        String
  /// Unidad de medida: kg, m², m, unidad, litro
  unit        String
  /// Precio por unidad en la moneda configurada
  pricePerUnit Float
  /// Moneda
  currency    String   @default("MXN")
  /// Propiedades técnicas adicionales (densidad, espesor, voltaje, potencia, etc.)
  properties  Json?
  /// Información del proveedor
  supplier    String?
  /// Disponible en inventario
  inStock     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}
