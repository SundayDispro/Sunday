# Copia este archivo a .env y ajusta los valores.
# DATABASE_URL es obligatorio para que la app funcione.
#
# PostgreSQL (recomendado para dev y prod):
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL="postgresql://sunday_user:sunday_pass@localhost:5432/sunday?schema=public"
PORT=3001
# Servidor final (Nginx): descomenta y ajusta orígenes reales (IP LAN + localhost).
# NODE_ENV=production
# En producción debes poner orígenes concretos (lista separada por comas).
# En este ejemplo (dev) se asume Vite en 5173/5174.
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174"
# Con Cloudflare Quick Tunnel (*.trycloudflare.com) la URL cambia al reiniciar cloudflared. Opciones:
# - ALLOW_TRYCLOUDFLARE_ORIGINS=1  → permite cualquier origen https://*.trycloudflare.com (además de ALLOWED_ORIGINS).
# - O lista cada URL en ALLOWED_ORIGINS (tedioso si reinicias el túnel a menudo).
# ALLOW_TRYCLOUDFLARE_ORIGINS=1
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
# API_BASE_URL=http://localhost:3001
#
# Opcional: UUID de usuario que firma mensajes del feed desde scripts locales (POST /api/internal/feed/system-message).
# Si no se define, se usa el primer usuario con role ADMIN.
# SYSTEM_FEED_AUTHOR_ID=
#
# PDF (Puppeteer): URL del frontend en ESTE PC. Con Nginx en 5173 suele ser loopback:
# FRONTEND_URL=http://127.0.0.1:5173
# (Aunque los usuarios entren por Cloudflare HTTPS, el headless debe abrir Nginx local.)

# Auth JWT (backend)
# Generar JWT_SECRET con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN="7d"
BCRYPT_ROUNDS=12
