# Copia este archivo a .env y ajusta los valores.
# DATABASE_URL es obligatorio para que la app funcione.
#
# PostgreSQL (recomendado para dev y prod):
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL="postgresql://sunday_user:sunday_pass@localhost:5432/sunday?schema=public"
PORT=3001
ALLOWED_ORIGINS=*
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
# API_BASE_URL=http://localhost:3001

# Auth JWT (backend)
# Cambia estos valores en producción
JWT_SECRET="cambia-esto-en-produccion"
JWT_EXPIRES_IN="7d"
