# Producción con Nginx (mismo origen en :5173, proxy /api y /socket.io):
# No definas VITE_API_URL (o déjalo vacío): el frontend usará rutas relativas.
#
# Solo si el frontend y el backend están en hosts/puertos distintos:
# VITE_API_URL=http://192.168.X.X:3001
#
# En `npm run dev`, Socket.IO usa por defecto el mismo hostname que la página y el puerto 3001.
# Si el backend escucha en otro puerto:
# VITE_DEV_BACKEND_PORT=3002
#
# Cloudflare Tunnel con `npm run dev` y dominio propio (no *.trycloudflare.com):
# VITE_TUNNEL_ALLOWED_HOSTS=sunday.ejemplo.com
